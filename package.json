{
  "name": "daily-check",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 1420 --strictPort",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "bundle:mac": "tauri build",
    "audit:public": "bash scripts/public_repo_audit.sh",
    "clean:public": "node scripts/clean_public_artifacts.mjs",
    "sync:dev": "npm --prefix sync-server run dev",
    "sync:build": "npm --prefix sync-server run build",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev --open --target aarch64",
    "android:build": "tauri android build --debug --target aarch64 --apk",
    "android:build:release": "tauri android build --target aarch64 --apk --aab",
    "android:devices": "$HOME/Library/Android/sdk/platform-tools/adb devices -l",
    "android:install": "$HOME/Library/Android/sdk/platform-tools/adb install -r src-tauri/gen/android/app/build/outputs/apk/universal/debug/app-universal-debug.apk",
    "android:logcat": "$HOME/Library/Android/sdk/platform-tools/adb logcat | grep --line-buffered -E \"Daily Check|RustWebView|WryActivity|AndroidRuntime\""
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
